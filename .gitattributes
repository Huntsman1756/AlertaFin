# Convencion de finales de linea: LF determinista para texto nuevo.

*.py    text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.jsonl text eol=lf
*.txt   text eol=lf

# === Overrides (al final: ganan) ===
# Evidencia congelada byte-exacta: los manifests registran sha256 de
# los bytes tal cual; cualquier conversion EOL romperia la cadena.
g0/**    -text
g0-r/**  -text
g1-wi/** -text

# Fingerprintado como selection_script_sha256 en g0/holdout-v2/manifest.json
scripts/holdout_v2.py -text
