# Convencion de finales de linea: LF determinista para texto nuevo.

*.py    text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.jsonl text eol=lf
*.txt   text eol=lf

# === Overrides (al final: ganan) ===
# Evidencia congelada byte-exacta: los manifests registran sha256 de
# los bytes tal cual; cualquier conversion EOL romperia la cadena.
# linguist-vendored: contenido de terceros replicado (snapshots HTML
# regulatorios); excluido de las estadisticas de lenguaje para que el
# repo clasifique como Python.
g0/**    -text linguist-vendored
g0-r/**  -text linguist-vendored
g1-wi/** -text linguist-vendored

# Fingerprintado como selection_script_sha256 en g0/holdout-v2/manifest.json
scripts/holdout_v2.py -text
